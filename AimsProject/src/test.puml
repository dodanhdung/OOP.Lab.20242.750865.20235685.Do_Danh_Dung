note "java.lang.Comparable" as N_Comparable
note "java.util.Comparator" as N_Comparator
note "java.util.ArrayList, java.util.List" as N_JavaUtilCollections
note "javafx.collections.ObservableList" as N_JavaFXCollections
note "java.lang.Exception" as N_Exception
note "javafx.application.Application, javafx.stage.Stage, javafx.scene.layout.GridPane, etc." as N_JavaFX_UI
note "javax.swing.JFrame, javax.swing.JPanel, etc." as N_Swing_UI

@enduml